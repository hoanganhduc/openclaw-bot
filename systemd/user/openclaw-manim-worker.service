[Unit]
Description=OpenClaw networkless Manim and TeX queue worker

[Service]
Type=simple
RuntimeDirectory=openclaw-bot-manim-worker
RuntimeDirectoryMode=0700
ExecStart=/usr/bin/python3 -I -S -B {{ OPENCLAW_LIBEXEC }}/host_exec.py --generation {{ OPENCLAW_LIBEXEC }} --artifact owner_state_lock.py -- --mode shared --lock-path {{ OWNER_STATE_LOCK }} -- /usr/bin/python3 -I -S -B {{ OPENCLAW_LIBEXEC }}/host_exec.py --generation {{ OPENCLAW_LIBEXEC }} --artifact job_queue_worker.sh
Environment=PATH=/usr/bin:/bin
Environment=TMPDIR=%t/openclaw-bot-manim-worker
Environment=OPENCLAW_WORKSPACE={{ OPENCLAW_WORKSPACE }}
Environment=OPENCLAW_STATE_DIR={{ OPENCLAW_HOME }}
Environment=OPENCLAW_LIBEXEC={{ OPENCLAW_LIBEXEC }}
Environment=OPENCLAW_QUEUE_KIND=manim
Environment=OPENCLAW_EXPECTED_OWNER_STATE_LOCK={{ OWNER_STATE_LOCK }}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=tmpfs
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
MemoryMax=4G
MemorySwapMax=1G
TasksMax=512
CPUQuota=200%
LimitNOFILE=1024
LimitFSIZE=2G
BindReadOnlyPaths={{ OPENCLAW_LIBEXEC_ROOT }}
BindReadOnlyPaths=-{{ USER_HOME }}/.local/share/manim-math-animation-venv
BindPaths={{ OWNER_STATE_LOCK }}
BindPaths={{ OPENCLAW_WORKSPACE }}/data/manim-queue
BindPaths={{ OPENCLAW_WORKSPACE }}/data/research/manim
BindPaths={{ OPENCLAW_WORKSPACE }}/data/exports

[Install]
WantedBy=default.target
